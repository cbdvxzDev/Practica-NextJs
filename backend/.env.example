# ---------------------------------------------------------------
# Copia este archivo a .env dentro de backend/ y rellena lo que
# necesites. .env* esta en .gitignore, asi que NUNCA se sube al repo.
# En local, ademas, arranca el backend con: ./mvnw spring-boot:run
# (todo tiene valor por defecto en application.yml).
# ---------------------------------------------------------------

# Base de datos (obligatoria en produccion).
# Atlas -> ver pasos en .env.example de la raiz del repo.
# MONGO_URI=mongodb+srv://TU_USUARIO:<db_password>@TU_CLUSTER.mongodb.net/esencial?retryWrites=true&w=majority

# Secreto con el que se firman los JWT (HS256).
# OBLIGATORIO en produccion; genera uno con: openssl rand -hex 32
# JWT_SECRET=

# Duracion del token (acepta formato Spring: 24h, 30m, 7d...).
# JWT_TTL=24h

# Origenes permitidos por CORS: dominio del front, sin barra final.
# Con mas de uno, sepáralos por coma.
# CORS_ALLOWED_ORIGINS=https://<tu-sitio>.netlify.app

# Siembra el catalogo y las cuentas de prueba en el arranque (1 activa).
# APP_SEED=1

# Puerto HTTP (por defecto 8080).
# PORT=8080
