{
  "name": "curso-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:api": "mvn -f backend/pom.xml test",
    "images": "node scripts/catalog-images.mjs",
    "images:harvest": "node scripts/catalog-images.mjs --harvest",
    "images:force": "node scripts/catalog-images.mjs --force",
    "images:report": "node scripts/catalog-images.mjs --report"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "mongodb": "^7.6.0"
  }
}
