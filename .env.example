# ---------------------------------------------------------------
# Copia este archivo a .env.local y rellena lo que necesites.
# .env* esta en .gitignore, asi que esto NUNCA se sube al repo.
# ---------------------------------------------------------------

# Origen publico de la tienda. Lo usan el sitemap, robots y las URLs absolutas
# de Open Graph. En local no hace falta tocarlo (cae a http://localhost:3000),
# pero en despliegue debe ser el dominio real, sin barra final.
# NEXT_PUBLIC_SITE_URL=https://esencial.store

# ---------------------------------------------------------------
# Backend Spring Boot (modo integrado)
# ---------------------------------------------------------------
# Sin esta variable todo el trafico va a la mini API de Next incluida en el
# proyecto (modo local y tests E2E). Al definirla, los servicios de productos,
# categorias, pedidos y usuarios/perfil pasan a hablar con Spring, y las
# rutas /api/auth/* del BFF reenvian login, registro, perfil y recuperacion de
# clave al backend (Spring setea su propio JWT en la cookie de sesion).
#
# OJO: NEXT_PUBLIC_* se inyecta en build, define la variable ANTES de
# `next build` (en Netlify: Site configuration > Environment variables).
# No pongas barra final ni el sufijo /api, solo el origen:
# NEXT_PUBLIC_API_URL=http://localhost:8080
#
# En el servidor (route handlers y server components) tambien se lee API_URL,
# util si quieres apuntar a otro backend sin reconstruir el cliente.
# API_URL=https://esencial-api.onrender.com

# Secreto con el que se firman los tokens de sesion (HMAC-SHA256).
# OBLIGATORIO en produccion: sin el, la app arranca con un valor de desarrollo
# que esta en el repositorio, y cualquiera que lea el codigo podria fabricar un
# token admin valido. La app se niega a arrancar en produccion si falta, asi que
# un despliegue sin esto falla de forma visible en lugar de abrir el panel.
# Genera uno con:  openssl rand -hex 32
# AUTH_SECRET=

# Motor de datos.
# Sin esto la app usa el motor de archivos JSON de /data y funciona igual.
# Al definirlo, app/lib/db.ts cambia al motor de MongoDB automaticamente.
#
# MongoDB Atlas -> https://www.mongodb.com/atlas
# 1. Create a new cluster (elShared gratis M0 vale)
# 2. Database Access -> Add New Database User  (anota usuario y contrasena)
# 3. Network Access -> Add IP Address        (0.0.0.0/0 solo para desarrollo)
# 4. Copy URI del cluster y sustituye <db_password> por tu contrasena real
#
# MONGODB_URI=mongodb+srv://TU_USUARIO:<db_password>@TU_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=PracticaNextJs

# -----------------------------------------------
# Harvest de imagenes del catalogo (opcional)
# -----------------------------------------------
# Sin credenciales el harvest funciona, pero la API de Openverse limita a
# page_size=20 y se satura rapido (429), asi que quedan pocos candidatos por
# producto. Con credenciales sube a page_size=200 y se pueden cubrir los 48
# productos con 3 fotos cada uno.
#
# Registro: https://api.openverse.org/v1/auth_tokens/register/
# Devuelve client_id y client_secret. Descomenta las dos lineas:
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=

# page_size solo: 20 sin credenciales, 200 por defecto con ellas.
# OPENVERSE_PAGE_SIZE=200
