{
    "java.compile.nullAnalysis.mode": "automatic",

    // "automatic" y no "interactive": al cambiar el pom.xml, la extension importa
    // solo. Con "interactive" salia un aviso y, si no se aceptaba, el proyecto se
    // quedaba con el classpath viejo y marcaba errores que no existen.
    "java.configuration.updateBuildConfiguration": "automatic",

    // El backend es un proyecto Maven anidado en backend/, no en la raiz del
    // workspace, asi que hay que forzar el import de Maven de forma explicita.
    "java.import.maven.enabled": true,

    // El JDK no se fija aqui a proposito: una ruta absoluta de disco en un
    // archivo versionado rompe el proyecto al resto y no aporta nada. Se
    // configura en los ajustes de usuario. Ver .vscode/README.md.
    "java.test.defaultConfig": "default",

    // Esta lista es la que hace que JDT marque "Null type safety: parameter
    // 'this' needs unchecked conversion to conform to @NonNull" en los
    // metodos-referencia. Sin esta configuracion el aviso no aparece, y
    // desactivarlo tampoco es la solucion: la causa es la ultima entrada.
    //
    // org.springframework.lang.NonNullApi va por defecto, y JDT lo interpreta
    // como "todo este paquete es no nulable". Spring lo pone en el package-info
    // de sus paquetes, asi que la anotacion se propaga desde las APIs de Spring
    // hasta el codigo propio: el Optional<User> que devuelve findById hace que
    // User cuente como no nulable, y entonces una referencia como User::isActive
    // parece incumplir la promesa, porque Predicate.test no declara nada.
    //
    // Quitar Spring de la lista no desactiva el analisis: el proyecto no usa
    // @NonNullApi en ningun sitio (no hay package-info.java), asi que lo unico
    // que se pierde es la inferencia tomada de las anotaciones de Spring. Un
    // NullPointerException posible en codigo propio se sigue marcando.
    "java.compile.nullAnalysis.nonnullbydefault": [
        "javax.annotation.ParametersAreNonnullByDefault",
        "org.eclipse.jdt.annotation.NonNullByDefault",
        "org.jspecify.annotations.NullMarked"
    ]
}
